# ====================================
# BFF (Backend-for-Frontend) — Variables de Entorno
# ====================================
# Copia este archivo como bff/.env y rellena los valores.

# === SUPABASE ===
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# === FASTAPI (IA / RAG / Chat) ===
FASTAPI_URL=http://localhost:8001

# === REDIS (sesiones) ===
REDIS_URL=redis://localhost:6379/0

# === SESIONES ===
# Mínimo 32 caracteres aleatorios
SESSION_SECRET=

# === SERVIDOR ===
PORT=3000

# === CORS ===
CORS_ORIGIN=http://localhost:5174
