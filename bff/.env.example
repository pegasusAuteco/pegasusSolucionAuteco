# ====================================
# BFF (Backend-for-Frontend) — Environment Variables
# ====================================
# Copy this file as bff/.env and fill in the values.

# === SUPABASE ===
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# === FASTAPI (AI / RAG / Chat) ===
FASTAPI_URL=http://localhost:8001

# === REDIS (sessions) ===
REDIS_URL=redis://localhost:6379/0

# === SESSIONS ===
# Minimum 32 random characters
SESSION_SECRET=

# === SERVER ===
PORT=3000

# === CORS ===
CORS_ORIGIN=http://localhost:5174
