# ====================================
# MotorConnect — Variables de Entorno
# ====================================
# Copia este archivo como .env y rellena los valores.

# === SUPABASE ===
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# (Prefijo VITE_ leído por el frontend en build time)
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# === OPENAI / LLM ===
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# === VECTOR STORE (tabla en Supabase) ===
VECTOR_TABLE=manuales_chunks
VECTOR_MATCH_COUNT=5

# === DATABASE (Supabase PostgreSQL) ===
DATABASE_URL=

# === AUTH ===
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# === BACKEND ===
API_PORT=8000

# === MongoDB Atlas (logs de conversación) ===
MONGO_URI=
MONGO_DB_NAME=motorconnect_logs

# === Redis Cloud (sesiones activas) ===
REDIS_URL=

# === GROQ (transcripción de voz, opcional) ===
GROQ_API_KEY=
