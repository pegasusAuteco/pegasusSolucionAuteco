# ====================================
# MotorConnect — Variables de Entorno
# ====================================
# Copia este archivo como .env y rellena los valores reales.
# Nunca subas .env al repositorio.

# ─── BASE DE DATOS ───────────────────────────────────────────────────────────

# Usuario de PostgreSQL (contenedor local)
DB_USER=motorconnect

# Contraseña de PostgreSQL (contenedor local)
DB_PASSWORD=cambia_esto_en_produccion

# Nombre de la base de datos PostgreSQL
DB_NAME=motorconnect_db

# URL completa de conexión async para SQLAlchemy
# Formato local:    postgresql+asyncpg://DB_USER:DB_PASSWORD@db:5432/DB_NAME
# Formato Supabase: postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://motorconnect:cambia_esto_en_produccion@db:5432/motorconnect_db

# ─── SUPABASE ────────────────────────────────────────────────────────────────

# URL del proyecto Supabase (panel → Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Clave de servicio (service_role) — acceso total, solo backend/BFF, nunca al frontend
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.SERVICE_ROLE_KEY_AQUI

# ─── BACKEND (FastAPI) ───────────────────────────────────────────────────────

# Clave para firmar y verificar tokens JWT — debe ser idéntica en backend y BFF
JWT_SECRET=minimo_32_caracteres_cambia_esto_en_produccion

# Algoritmo de firma JWT (no cambiar salvo migración explícita)
JWT_ALGORITHM=HS256

# Horas de validez del token JWT
JWT_EXPIRATION_HOURS=24

# Clave de API de OpenAI para LLM y embeddings
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de lenguaje a usar
LLM_MODEL=gpt-4o-mini

# Modelo de embeddings para RAG
EMBEDDING_MODEL=text-embedding-3-small

# Nombre de la tabla pgvector en Supabase que almacena los chunks de manuales
VECTOR_TABLE=manuales_chunks

# Número de chunks a recuperar en cada búsqueda RAG
VECTOR_MATCH_COUNT=5

# Puerto interno del servidor FastAPI
API_PORT=8000

# Entorno de ejecución: development | production
ENVIRONMENT=development

# Activar logs detallados de FastAPI (True | False)
DEBUG=False

# ─── BFF (Express) ───────────────────────────────────────────────────────────

# Secreto para firmar cookies de sesión — mínimo 32 caracteres
SESSION_SECRET=minimo_32_caracteres_cambia_esto_en_produccion

# Origen permitido por CORS (URL del frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# ─── MONGODB ─────────────────────────────────────────────────────────────────

# Usuario root de MongoDB (contenedor local)
MONGO_USER=motorconnect

# Contraseña root de MongoDB (contenedor local)
MONGO_PASSWORD=cambia_esto_en_produccion

# URI de conexión completa — local o Atlas
# Formato local: mongodb://MONGO_USER:MONGO_PASSWORD@mongodb:27017/motorconnect_logs?authSource=admin
# Formato Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/
MONGO_URI=mongodb://motorconnect:cambia_esto_en_produccion@mongodb:27017/motorconnect_logs?authSource=admin

# Nombre de la base de datos MongoDB para logs de conversación
MONGO_DB_NAME=motorconnect_logs

# ─── REDIS ───────────────────────────────────────────────────────────────────

# URL de conexión a Redis — local o Redis Cloud
# Formato local: redis://redis:6379/0
# Formato cloud: redis://default:PASSWORD@host:PORT/0
REDIS_URL=redis://redis:6379/0

# ─── QDRANT ──────────────────────────────────────────────────────────────────

# Clave de API para autenticación con Qdrant
QDRANT_API_KEY=cambia_esto_en_produccion

# ─── FRONTEND (Vite) ─────────────────────────────────────────────────────────

# URL base de la API consumida por el frontend (proxeada por Nginx en producción)
VITE_API_URL=/api

# URL del proyecto Supabase — expuesta al browser (igual que SUPABASE_URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anon/public de Supabase — expuesta al browser, segura solo con RLS activo
VITE_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ANON_KEY_AQUI

# ─── OTROS ───────────────────────────────────────────────────────────────────

# Clave de API de Groq para transcripción de voz (opcional)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
